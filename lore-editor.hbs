<form class="recall-knowledge-dialog recall-knowledge-lore-editor">
  <p>
    Success and Critical Success now pull real stats straight off
    <strong>{{name}}</strong>'s sheet automatically — you don't need to write
    anything for those. This editor only covers what happens on a
    <strong>Critical Failure</strong>.
  </p>

  <div class="form-group">
    <label>False info (shown to the player as fact on a Critical Failure)</label>
    <textarea name="falseInfo" rows="3">{{falseInfo}}</textarea>
  </div>

  <div class="form-group">
    <label>GM notes (never shown to players — e.g. the actual truth)</label>
    <textarea name="gmNotes" rows="2">{{gmNotes}}</textarea>
  </div>
</form>
